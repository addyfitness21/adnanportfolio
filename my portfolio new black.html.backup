<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Adnan Ali — Founder & Builder</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Plus Jakarta Sans for UI, Great Vibes for the iconic Amsterdam style signature -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Great+Vibes&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        signature: ['"Great Vibes"', 'cursive'],
                        serif: ['"Playfair Display"', 'serif'],
                    },
                    colors: {
                        accentRed: '#f43f5e',
                        accentTeal: '#10b981',
                        brandGold: '#e2b857'
                    }
                }
            }
        }
    </script>
    
    <style>
        /* Exact Amsterdam signature style replica from screenshot */
        .amsterdam-signature {
            font-family: 'Great Vibes', cursive;
            font-size: 2.8rem;
            line-height: 0.9;
            font-weight: 400;
            color: #ffffff;
            display: inline-block;
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.5), 0 0 20px rgba(255, 255, 255, 0.2);
        }
        @media (min-width: 640px) {
            .amsterdam-signature {
                font-size: 3.4rem;
            }
        }
        
        /* Floating Character Animation for the Right Column */
        @keyframes subtleFloat {
            0%, 100% {
                transform: translateY(0px) scale(1);
            }
            50% {
                transform: translateY(-10px) scale(1.01);
            }
        }
        .animate-float {
            animation: subtleFloat 7s ease-in-out infinite;
        }

        /* Subtle glowing dots in background */
        @keyframes pulseGlow {
            0%, 100% { opacity: 0.15; transform: scale(1); }
            50% { opacity: 0.3; transform: scale(1.1); }
        }
        .animate-pulse-glow {
            animation: pulseGlow 10s ease-in-out infinite;
        }

        /* Premium scrollbar styling */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #09090b;
        }
        ::-webkit-scrollbar-thumb {
            background: #27272a;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #f43f5e;
        }
    </style>
</head>
<body class="bg-black text-zinc-100 font-sans selection:bg-rose-500 selection:text-white min-h-screen overflow-x-hidden relative">

    <!-- Background lights to complement white, red, and green highlights on the character jacket -->
    <div class="absolute top-1/4 left-10 w-72 h-72 sm:w-96 sm:h-96 bg-accentTeal/10 rounded-full blur-[120px] pointer-events-none animate-pulse-glow"></div>
    <div class="absolute bottom-1/4 right-10 w-80 h-80 sm:w-[500px] sm:h-[500px] bg-accentRed/10 rounded-full blur-[150px] pointer-events-none animate-pulse-glow" style="animation-delay: 2s;"></div>

    <!-- MAIN NAV BAR: Floating Glassmorphic Capsule Styled EXACTLY like Screenshot -->
    <header class="fixed top-6 left-1/2 -translate-x-1/2 w-[92%] max-w-7xl z-50">
        <nav class="backdrop-blur-xl bg-zinc-950/70 border border-zinc-800/80 rounded-full px-6 py-2 sm:py-2.5 flex items-center justify-between shadow-[0_10px_35px_rgba(0,0,0,0.7)]">
            
            <!-- LEFT: Custom Adnan Ali Signature written in "Amsterdam Three" typeface -->
            <div class="flex-1 flex justify-start items-center">
                <a href="#home" class="group flex items-center pt-1.5 pb-1 select-none">
                    <span class="amsterdam-signature transition-colors duration-300">
                        Adnan Ali
                    </span>
                </a>
            </div>

            <!-- CENTER (In-Between): Menu Sections requested: Home, Personal, Business, About Me, Contact -->
            <div class="hidden lg:flex items-center justify-center space-x-1 sm:space-x-2 text-[14px] font-semibold tracking-wide text-zinc-400">
                <a href="#home" class="px-5 py-2.5 rounded-full text-white bg-zinc-900/80 border border-zinc-800/40 transition-all duration-300">Home</a>
                <a href="#personal" onclick="showSectionToast('Personal Portal')" class="px-4 py-2 rounded-full hover:text-white hover:bg-zinc-900/20 transition-all duration-300">Personal</a>
                <a href="#business" onclick="showSectionToast('Business & Brands')" class="px-4 py-2 rounded-full hover:text-white hover:bg-zinc-900/20 transition-all duration-300">Business</a>
                <a href="#about" onclick="showSectionToast('About Narrative')" class="px-4 py-2 rounded-full hover:text-white hover:bg-zinc-900/20 transition-all duration-300">About Me</a>
                <a href="#contact" onclick="showSectionToast('Secure Connection')" class="px-4 py-2 rounded-full hover:text-white hover:bg-zinc-900/20 transition-all duration-300">Contact</a>
            </div>

            <!-- RIGHT: Social Media & Connection Icons (Clean Minimalist matching your screenshot) -->
            <div class="flex-1 flex items-center justify-end gap-3">
                <div class="flex items-center space-x-4 sm:space-x-5 text-zinc-400">
                    <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-all duration-300" title="Facebook">
                        <i class="fab fa-facebook-f text-[15px]"></i>
                    </a>
                    <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-all duration-300" title="Instagram">
                        <i class="fab fa-instagram text-[16px]"></i>
                    </a>
                    <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-all duration-300" title="LinkedIn">
                        <i class="fab fa-linkedin-in text-[15px]"></i>
                    </a>
                    <a href="mailto:hello@adnanali.co" class="hover:text-white transition-all duration-300" title="Send Email">
                        <i class="far fa-envelope text-[15px]"></i>
                    </a>
                    <a href="https://adnanali.co" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-all duration-300" title="Global Website">
                        <i class="fas fa-globe text-[15px]"></i>
                    </a>
                </div>

                <!-- Mobile Hamburger Menu Button -->
                <button id="mobileMenuBtn" class="lg:hidden w-8 h-8 rounded-full bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-400 hover:text-white focus:outline-none transition-all duration-300" aria-label="Toggle Navigation">
                    <i id="menuIcon" class="fas fa-bars text-xs"></i>
                </button>
            </div>
        </nav>

        <!-- Mobile Navigation Menu Dropdown -->
        <div id="mobileMenu" class="hidden lg:hidden mt-3 mx-4 p-4 rounded-3xl bg-zinc-950/95 border border-zinc-800/90 shadow-2xl backdrop-blur-2xl transition-all duration-300 flex flex-col gap-2">
            <a href="#home" class="px-4 py-3 rounded-xl text-white bg-zinc-900/50 flex items-center justify-between">
                <span>Home</span>
                <i class="fas fa-chevron-right text-xs text-zinc-500"></i>
            </a>
            <a href="#personal" onclick="toggleMobileMenu(); showSectionToast('Personal Portal')" class="px-4 py-3 rounded-xl text-zinc-400 hover:text-white hover:bg-zinc-900/30 flex items-center justify-between">
                <span>Personal</span>
                <i class="fas fa-chevron-right text-xs text-zinc-500"></i>
            </a>
            <a href="#business" onclick="toggleMobileMenu(); showSectionToast('Business & Brands')" class="px-4 py-3 rounded-xl text-zinc-400 hover:text-white hover:bg-zinc-900/30 flex items-center justify-between">
                <span>Business</span>
                <i class="fas fa-chevron-right text-xs text-zinc-500"></i>
            </a>
            <a href="#about" onclick="toggleMobileMenu(); showSectionToast('About Narrative')" class="px-4 py-3 rounded-xl text-zinc-400 hover:text-white hover:bg-zinc-900/30 flex items-center justify-between">
                <span>About Me</span>
                <i class="fas fa-chevron-right text-xs text-zinc-500"></i>
            </a>
            <a href="#contact" onclick="toggleMobileMenu(); showSectionToast('Secure Connection')" class="px-4 py-3 rounded-xl text-zinc-400 hover:text-white hover:bg-zinc-900/30 flex items-center justify-between">
                <span>Contact</span>
                <i class="fas fa-chevron-right text-xs text-zinc-500"></i>
            </a>
        </div>
    </header>

    <!-- IMMERSIVE MAIN HERO SECTION (Heading on Left, Avatar Image on Right) -->
    <!-- pt-32 & lg:pt-40 ensures heading & content load clearly and elegantly below the navigation bar -->
    <section id="home" class="min-h-screen w-full flex items-center justify-center pt-32 sm:pt-36 lg:pt-40 pb-16 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
        
        <!-- Center-Aligned Grid Blueprint: Text Left, Character Right -->
        <div class="w-full max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
            
            <!-- LEFT CONTENT COLUMN (Heading & Details) -->
            <div class="lg:col-span-7 flex flex-col items-start justify-center text-left z-10 space-y-6 sm:space-y-8 order-2 lg:order-1">
                
                <!-- Tagline Badge -->
                <div class="inline-flex items-center gap-2 bg-gradient-to-r from-zinc-900 via-zinc-900/80 to-zinc-950 border border-zinc-800 rounded-full pl-3.5 pr-4 py-1.5 text-xs font-semibold tracking-wider text-rose-400 uppercase shadow-md select-none">
                    <span class="flex h-2 w-2 relative">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-rose-500"></span>
                    </span>
                    Founder <span class="text-zinc-600 px-1">•</span> Builder <span class="text-zinc-600 px-1">•</span> Entrepreneur
                </div>

                <!-- Epic Main Headline -->
                <div class="space-y-3 sm:space-y-4">
                    <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.1] sm:leading-[1.05]">
                        Building brands <br>
                        that improve how <br class="hidden sm:inline">
                        people <span class="bg-gradient-to-r from-rose-400 via-pink-500 to-emerald-400 bg-clip-text text-transparent italic font-serif">live, eat,</span><br class="sm:hidden">
                        and <span class="bg-gradient-to-r from-emerald-400 via-teal-500 to-rose-400 bg-clip-text text-transparent">grow.</span>
                    </h1>
                </div>

                <!-- Descriptive Subtext -->
                <p class="text-zinc-400 text-base sm:text-lg md:text-xl max-w-xl font-light leading-relaxed">
                    I turn ideas into structured growth. I don't just build brands — I build the <span class="text-emerald-400 font-semibold border-b border-emerald-500/30 pb-0.5">systems</span> behind them.
                </p>

                <!-- CALLS TO ACTION & LIVE INTERACTIVE SIMULATOR WIDGET -->
                <div class="w-full max-w-lg space-y-6">
                    <!-- Interactive Growth Systems Simulator Widget -->
                    <div class="p-5 rounded-2xl bg-zinc-950/80 border border-zinc-800/80 shadow-[0_12px_40px_rgba(0,0,0,0.8)] backdrop-blur-md relative overflow-hidden group">
                        <!-- Custom grid layout overlay in widget -->
                        <div class="absolute inset-0 bg-[linear-gradient(to_right,#1f1f23_1px,transparent_1px),linear-gradient(to_bottom,#1f1f23_1px,transparent_1px)] bg-[size:24px_24px] opacity-10 pointer-events-none"></div>

                        <div class="relative flex items-center justify-between mb-4 border-b border-zinc-800 pb-3">
                            <div class="flex items-center gap-2">
                                <div class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></div>
                                <h3 class="text-xs uppercase tracking-widest font-bold text-zinc-300">Live Brand Systems Engine</h3>
                            </div>
                            <span class="text-[10px] text-zinc-500 font-mono">Status: Optimal</span>
                        </div>

                        <!-- Grid representing operational inputs -->
                        <div class="space-y-3.5 relative">
                            <!-- Slider 1 -->
                            <div class="space-y-1">
                                <div class="flex justify-between text-xs">
                                    <span class="text-zinc-400 font-medium">Brand Narrative & Experience</span>
                                    <span id="valNarrative" class="text-rose-400 font-mono font-bold">85%</span>
                                </div>
                                <input type="range" id="slideNarrative" min="10" max="100" value="85" 
                                    class="w-full h-1.5 bg-zinc-800 rounded-lg appearance-none cursor-pointer accent-rose-500 focus:outline-none"
                                    oninput="updateSimulator()">
                            </div>
                            <!-- Slider 2 -->
                            <div class="space-y-1">
                                <div class="flex justify-between text-xs">
                                    <span class="text-zinc-400 font-medium">Product & Supply Chain Integrity</span>
                                    <span id="valSupply" class="text-emerald-400 font-mono font-bold">90%</span>
                                </div>
                                <input type="range" id="slideSupply" min="10" max="100" value="90" 
                                    class="w-full h-1.5 bg-zinc-800 rounded-lg appearance-none cursor-pointer accent-emerald-500 focus:outline-none"
                                    oninput="updateSimulator()">
                            </div>
                            <!-- Slider 3 -->
                            <div class="space-y-1">
                                <div class="flex justify-between text-xs">
                                    <span class="text-zinc-400 font-medium">Operational Speed & Automation</span>
                                    <span id="valOps" class="text-cyan-400 font-mono font-bold">75%</span>
                                </div>
                                <input type="range" id="slideOps" min="10" max="100" value="75" 
                                    class="w-full h-1.5 bg-zinc-800 rounded-lg appearance-none cursor-pointer accent-cyan-400 focus:outline-none"
                                    oninput="updateSimulator()">
                            </div>
                        </div>

                        <!-- Live Compounding Readout -->
                        <div class="mt-4 pt-3 border-t border-zinc-900 flex items-center justify-between text-sm">
                            <span class="text-zinc-500 text-xs">Simulated Growth Potential:</span>
                            <div class="flex items-baseline gap-1.5">
                                <span id="scaleMultiplier" class="text-xl sm:text-2xl font-black bg-gradient-to-r from-rose-400 to-emerald-400 bg-clip-text text-transparent font-mono">3.4x</span>
                                <span class="text-[10px] text-zinc-500 font-mono font-bold">Scale</span>
                            </div>
                        </div>
                    </div>

                    <!-- Call To Action Interaction triggers -->
                    <div class="flex flex-wrap items-center gap-4">
                        <button onclick="showSectionToast('Initiating Connection Protocol')" class="px-8 py-4 rounded-full bg-gradient-to-r from-rose-500 to-rose-600 text-white font-bold text-sm tracking-wide hover:shadow-[0_8px_24px_rgba(244,63,94,0.35)] hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200">
                            Let's Connect <i class="fas fa-arrow-right ml-2 text-xs"></i>
                        </button>
                        <a href="#about" onclick="showSectionToast('Launching Enterprise Strategy Portfolio')" class="px-6 py-4 rounded-full border border-zinc-800 hover:border-zinc-700 bg-zinc-950/40 hover:bg-zinc-900/60 text-zinc-300 hover:text-white font-semibold text-sm tracking-wide transition-all duration-200">
                            Explore Ventures
                        </a>
                    </div>
                </div>

            </div>

            <!-- RIGHT COLUMN (IMAGE): High Fidelity Avatar Showcase placed precisely on Right -->
            <div class="lg:col-span-5 flex items-center justify-center relative order-1 lg:order-2">
                
                <!-- Back Radiant Ring Graphics -->
                <div class="absolute w-[280px] h-[280px] sm:w-[420px] sm:h-[420px] rounded-full border border-zinc-800/50 flex items-center justify-center">
                    <div class="w-[220px] h-[220px] sm:w-[320px] sm:h-[320px] rounded-full border border-dashed border-zinc-700/20 animate-spin" style="animation-duration: 60s;"></div>
                </div>
                <div class="absolute w-72 h-72 sm:w-96 sm:h-96 rounded-full bg-gradient-to-tr from-rose-600/10 to-emerald-500/10 blur-[60px] pointer-events-none"></div>

                <!-- Avatar wrapper loading "Insta Posts (3).jpg" with precise backup error boundaries -->
                <div class="relative max-w-[280px] sm:max-w-md lg:max-w-full animate-float">
                    <img 
                        src="Insta Posts (3).jpg" 
                        alt="Adnan Ali Character Artwork" 
                        class="w-full h-auto object-contain select-none drop-shadow-[0_20px_50px_rgba(244,63,94,0.25)] rounded-[2.5rem] relative z-10"
                        onerror="this.src='https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=600&q=85'; this.className='w-full h-auto rounded-[2.5rem] opacity-70 z-10';"
                    />
                    
                    <!-- Decortive Pill Label 1 -->
                    <div class="absolute -bottom-4 -left-6 z-20 bg-zinc-950/95 border border-zinc-800/80 px-4 py-3 rounded-2xl flex items-center gap-3 backdrop-blur-md shadow-2xl">
                        <div class="w-10 h-10 rounded-xl bg-rose-500/10 flex items-center justify-center text-rose-400">
                            <i class="fas fa-fire"></i>
                        </div>
                        <div>
                            <div class="text-[10px] uppercase text-zinc-500 tracking-wider font-bold">Focus Phase</div>
                            <div class="text-xs sm:text-sm font-extrabold text-white">Scaling Systems</div>
                        </div>
                    </div>

                    <!-- Decortive Pill Label 2 -->
                    <div class="absolute -top-4 -right-4 z-20 bg-zinc-950/95 border border-zinc-800/80 px-4 py-3 rounded-2xl flex items-center gap-3 backdrop-blur-md shadow-2xl">
                        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-400">
                            <i class="fas fa-bolt"></i>
                        </div>
                        <div>
                            <div class="text-[10px] uppercase text-zinc-500 tracking-wider font-bold">Operations</div>
                            <div class="text-xs sm:text-sm font-extrabold text-white">100% Automated</div>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </section>

    <!-- FLOATING INTERACTIVE TOAST SYSTEM (Elegantly replaces traditional browser Alerts) -->
    <div id="toast" class="fixed bottom-6 right-6 z-50 transform translate-y-24 opacity-0 transition-all duration-300 ease-out pointer-events-none">
        <div class="bg-zinc-900 border border-zinc-800/90 rounded-2xl px-5 py-4 flex items-center gap-3.5 shadow-[0_16px_40px_rgba(0,0,0,0.8)] backdrop-blur-xl">
            <div class="w-8 h-8 rounded-full bg-emerald-500/10 flex items-center justify-center text-emerald-400">
                <i class="fas fa-terminal text-sm"></i>
            </div>
            <div>
                <div class="text-[10px] text-zinc-500 uppercase tracking-widest font-extrabold">System Protocol</div>
                <div id="toastMessage" class="text-xs text-zinc-200 font-mono font-medium">Redirecting pathway...</div>
            </div>
        </div>
    </div>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        // Toggle mobile navigation menu logic
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        const menuIcon = document.getElementById('menuIcon');

        function toggleMobileMenu() {
            mobileMenu.classList.toggle('hidden');
            const isHidden = mobileMenu.classList.contains('hidden');
            menuIcon.className = isHidden ? 'fas fa-bars text-sm' : 'fas fa-times text-sm';
        }

        mobileMenuBtn.addEventListener('click', toggleMobileMenu);

        // Premium replacement for default alerts
        function showSectionToast(message) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMessage');
            
            toastMsg.innerText = message;
            toast.classList.remove('translate-y-24', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');
            
            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-24', 'opacity-0');
            }, 3500);
        }

        // Live calculation logic for interactive brand growth simulator widget
        function updateSimulator() {
            const narrative = parseFloat(document.getElementById('slideNarrative').value);
            const supply = parseFloat(document.getElementById('slideSupply').value);
            const ops = parseFloat(document.getElementById('slideOps').value);

            document.getElementById('valNarrative').innerText = narrative + '%';
            document.getElementById('valSupply').innerText = supply + '%';
            document.getElementById('valOps').innerText = ops + '%';

            // Custom compounding formula demonstrating balanced system growth scaling potential
            const average = (narrative + supply + ops) / 3;
            const balanceFactor = 1 - (Math.max(narrative, supply, ops) - Math.min(narrative, supply, ops)) / 150;
            const multiplier = ((average / 100) * 4.5 * Math.max(0.5, balanceFactor)).toFixed(1);

            document.getElementById('scaleMultiplier').innerText = multiplier + 'x';
        }

        // Initialize equations on load
        window.addEventListener('DOMContentLoaded', () => {
            updateSimulator();
        });
    </script>
</body>
</html>